package Ejercicio;

import java.util.Scanner;
public class Estudiante {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String[] asignaturas;
        int[] notas;
        String nombre, carrera;
        int edad, numMaterias;
        System.out.print("Nombre: ");
        nombre = sc.nextLine();
        System.out.print("Edad: ");
        edad = sc.nextInt();
        sc.nextLine(); 
        
        System.out.print("Carrera: ");
        carrera = sc.nextLine();
        System.out.print("Cuantas materias deseas ingresar? ");
        numMaterias = sc.nextInt();
        sc.nextLine();
        
        asignaturas = new String[numMaterias];
        notas = new int[numMaterias];
        for (int i = 0; i < numMaterias; i++) {
            System.out.print("Asignatura " + (i + 1) + ": ");
            asignaturas[i] = sc.nextLine();
            System.out.print("Nota de " + asignaturas[i] + ": ");
            notas[i] = sc.nextInt();
            sc.nextLine();
        }
        System.out.println("\nDatos personales:");
        System.out.println("Nombre: " + nombre + ", Edad: " + edad + ", Carrera: " + carrera);
        System.out.println("\nAsignaturas y calificaciones:");
        for (int i = 0; i < numMaterias; i++) {
            System.out.println((i + 1) + ") " + asignaturas[i] + " = " + notas[i]);
        }
        int suma = 0;
        for (int i = 0; i < numMaterias; i++) {
            suma += notas[i];
        }
        double promedio = (double) suma / numMaterias;
        System.out.println("\nPromedio: " + promedio);
        if (promedio >= 60) {
            System.out.println("Estado: APROBADO");
        } else {
            System.out.println("Estado: REPROBADO");
        }

    }
}
